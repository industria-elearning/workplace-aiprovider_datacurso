{{!
    @template aiprovider_datacurso/setting_tenant

    TODO describe template user_token_limits

    Example context (json):
    {
    }
}}

<div class="aiprovider_datacurso_admin_wrapper">
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">{{#str}} licensekey, aiprovider_datacurso {{/str}}</h5>
            <div class="form-group">
                <input type="password" name="s_aiprovider_datacurso_licensekey" 
                       value="{{licensekey}}" class="form-control" id="id_licensekey">
            </div>
        </div>
    </div>

    <hr>

    <h4>{{#str}} ratelimits_heading, aiprovider_datacurso {{/str}}</h4>
    <p class="text-muted">{{#str}} ratelimits_heading_desc, aiprovider_datacurso {{/str}}</p>

    <div class="accordion" id="servicesAccordion">
        {{#services}}
        <div class="card mb-2">
            <div class="card-header" id="heading{{id}}">
                <h5 class="mb-0">
                    <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#collapse{{id}}">
                        {{name}}
                    </button>
                </h5>
            </div>

            <div id="collapse{{id}}" class="collapse show" data-parent="#servicesAccordion">
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input type="checkbox" name="s_aiprovider_datacurso_ratelimit_{{id}}_enable" 
                               class="form-check-input" id="enable_{{id}}" {{#enabled}}checked{{/enabled}}>
                        <label class="form-check-label" for="enable_{{id}}">
                            {{#str}} ratelimit_enable, aiprovider_datacurso {{/str}}
                        </label>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">{{#str}} ratelimit_limit, aiprovider_datacurso {{/str}}</label>
                        <div class="col-sm-9">
                            <input type="number" name="s_aiprovider_datacurso_ratelimit_{{id}}_limit" 
                                   value="{{limit}}" class="form-control w-25">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/services}}
    </div>
</div>
